# copiar a .env (o mejor a ../../private/inventarioti.env, fuera de public_html) y llenar
APP_ENV=local
APP_URL=http://localhost/inventarioti

DB_HOST=localhost
DB_NAME=inventarioti
DB_USER=root
DB_PASS=

# llave para cifrar claves wifi y pines (32 bytes en base64, ej. base64:...)
# no cambiarla despues de guardar claves: las guardadas ya no se podrian leer
APP_KEY=

# correo: por defecto usa el SMTP de otro proyecto (MAIL_HOST/PORT/USER/PASS) desde MAIL_ENV
# MAIL_ENV=/ruta/a/private/.env
# MAIL_HOST=smtp.ejemplo.com
# MAIL_PORT=587
# MAIL_SECURE=tls
# MAIL_USER=
# MAIL_PASS=
# o por api: none, resend o zeptomail
MAIL_PROVIDER=none
MAIL_API_KEY=
MAIL_FROM=sistemas@ejemplo.com
MAIL_FROM_NAME=Sistemas
# MAIL_REPLY=

# a quien le llega copia de cada acta firmada (separados por coma)
MAIL_COPIAS=
# a quien avisar cuando se bloquea un ingreso por claves malas
MAIL_ALERTAS=
# a quien le llega el aviso cuando alguien ingresa o cambia un equipo (separados por coma)
MAIL_INVENTARIO=

# copias de seguridad al disco externo (modulo Copias de seguridad)
# la clave del script sale de APP_KEY; para cambiarla pon aqui una cadena larga al azar
BACKUP_TOKEN=
# dias para la siguiente copia (1 = copia el 18, a mas tardar el 19; el 20 sin copia llega aviso). Los domingos no cuentan
BACKUP_DIAS=1
# carpetas que debe tener el disco, separadas por coma (vacio = todas las de la raiz del disco)
BACKUP_CARPETAS=
# copias diarias: carpeta donde cada dia se crea una carpeta nueva (03nov, 04nov...); se revisa solo la mas reciente.
# acepta comodin para el año. Vacio en el .env = "Copias diarias *". Para no usarlo: BACKUP_BASE=-
BACKUP_BASE=
# a quien le llega el aviso de la copia (vacio = los mismos de MAIL_INVENTARIO)
MAIL_RESPALDOS=

# tareas del equipo: hora (0-23) desde la que sale el resumen de la mañana (tareas_cron.php corre cada hora)
TAREAS_HORA_RESUMEN=7

# solicitudes a administracion: a quien le llegan los avisos (vacio = a quienes aprueban). No usa MAIL_INVENTARIO
MAIL_SOLICITUDES=
# dias sin recibirse para avisar los lunes (tareas_cron.php)
SOLICITUDES_DIAS_ALERTA=8

# base de la pagina web (solo lectura del historial de actualizaciones, modulo Pagina web)
WEB_DB_HOST=localhost
WEB_DB_PORT=3306
WEB_DB_NAME=
WEB_DB_USER=
WEB_DB_PASS=
# a quien avisar cada actualizacion de la pagina (vacio = los mismos de las copias de seguridad)
MAIL_WEB=
