# copiar a .env (o mejor a ../../private/inventarioti.env, fuera de public_html) y llenar
APP_ENV=local
APP_URL=http://localhost/inventarioti

DB_HOST=localhost
DB_NAME=inventarioti
DB_USER=root
DB_PASS=

# llave para cifrar claves wifi y pines (32 bytes en base64, ej. base64:...)
# no cambiarla despues de guardar claves: las guardadas ya no se podrian leer
APP_KEY=

# correo: por defecto usa el SMTP de otro proyecto (MAIL_HOST/PORT/USER/PASS) desde MAIL_ENV
# MAIL_ENV=/ruta/a/private/.env
# MAIL_HOST=smtp.ejemplo.com
# MAIL_PORT=587
# MAIL_SECURE=tls
# MAIL_USER=
# MAIL_PASS=
# o por api: none, resend o zeptomail
MAIL_PROVIDER=none
MAIL_API_KEY=
MAIL_FROM=sistemas@ejemplo.com
MAIL_FROM_NAME=Sistemas
# MAIL_REPLY=

# a quien le llega copia de cada acta firmada (separados por coma)
MAIL_COPIAS=
# a quien avisar cuando se bloquea un ingreso por claves malas
MAIL_ALERTAS=
# a quien le llega el aviso cuando alguien ingresa o cambia un equipo (separados por coma)
MAIL_INVENTARIO=
